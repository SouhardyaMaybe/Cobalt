# Gradle
plugin/build/
.gradle/

# Generated from config/cobalt-renderer.json by tools/gen-config.py, which
# build-android.sh runs before Gradle. Not tracked: it is a build product, and a
# stale copy in the repo is exactly the drift the generator exists to prevent.
plugin/generated/

# The renderer, staged by build-android.sh. Tracked nowhere; 54 MB per ABI.
plugin/src/main/jniLibs/

# Symbol lists published by the CI audit step.
exported-*.txt
# Signing key, generated by tools/gen-key.sh. Never commit it.
plugin/*.jks

# Copied from plugin/config/cobalt-settings.json by build-android.sh, because AGP
# packs jniLibs by extension and would drop a .json placed there without saying so.
# The renderer reads this at nativeLibraryDir/cobalt/config.json, installed on first
# launch by CobaltSettings. Not tracked for the same reason plugin/generated/ is not:
# a second committed copy is a second thing to forget to update, and this one is
# consumed by the renderer rather than read by a human, so the drift would be silent.
plugin/src/main/assets/
