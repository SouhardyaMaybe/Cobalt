+static inline bool is_identifier_char(char c) {
+    return std::isalnum(static_cast<unsigned char>(c)) != 0 || c == '_';
+}
+
+// `uniform` is a keyword, so it only counts where it stands on its own. Matching the
+// bare substring also matches identifiers that merely contain it, and since 26.3 every
+// uniform is an interface block whose instance name starts with `_uniform`. Firing
+// inside one of those consumed the enclosing condition and every statement up to the
+// next `;`, then rewrote the lot as a uniform declaration -- leaving a dangling `_`
+// in front of it, and the driver rejected the shader on the resulting syntax error.
+static inline bool is_uniform_keyword(const std::string& src, size_t pos) {
+    if (src.compare(pos, 7, "uniform") != 0) {
+        return false;
+    }
+    if (pos > 0 && is_identifier_char(src[pos - 1])) {
+        return false;
+    }
+    const size_t after = pos + 7;
+    return after >= src.size() || !is_identifier_char(src[after]);
+}
